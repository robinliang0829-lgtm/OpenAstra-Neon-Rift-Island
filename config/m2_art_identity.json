  "checklist": [
    {
      "id": "harbor.tokens",
      "owner": "both",
      "status": "spec_only",
      "text": "五个港区环境色和两个辅助色的 id、十六进制都来自 `palette.py`。环境色是 `mat.wet_concrete`、`mat.worn_yellow`、`env.sign_cyan`、`env.sign_magenta`、`env.sea_wall`。辅助色是 `aux.tide_cyan` `#3DDFD4`、`aux.hazard_amber` `#E2A23A`。不要在 Blender 或材质实例里另写一版。"
    },
    {
      "id": "harbor.concrete",
      "owner": "both",
      "status": "spec_only",
      "text": "`mat.wet_concrete`（`#3E4644`）铺甲板和路面。粗糙度高。验收关高反射，倒影不是读这块材质的条件。"
    },
    {
      "id": "harbor.signs",
      "owner": "both",
      "status": "spec_only",
      "text": "`env.sign_cyan`（`#2EC8C3`）和 `env.sign_magenta`（`#D24B7A`）只做环境招牌。它们不是队标，不能比肩章更抢。"
    },
    {
      "id": "harbor.yellow",
      "owner": "both",
      "status": "spec_only",
      "text": "`mat.worn_yellow`（`#C4A15A`）只涂港区工程机械，当比例参照。黄漆不是阵营。"
    },
    {
      "id": "harbor.seawall",
      "owner": "both",
      "status": "spec_only",
      "text": "`env.sea_wall`（`#6E7570`）是海堤色。兽和四足机可以共用这色，轮廓仍必须不同。不要靠换色把四足机当成兽。"
    },
    {
      "id": "badge.shape",
      "owner": "both",
      "status": "spec_only",
      "text": "A 是开口人字 `open_chevron`，折线 `16,44 32,20 48,44`，不回到起点。B 是闭合环 `closed_ring`，圆心 `32,32`，半径 `16`。视框 `0 0 64 64`，线宽 6。人字用方头。"
    },
    {
      "id": "badge.light",
      "owner": "both",
      "status": "spec_only",
      "text": "A 的灯矩形从 `4,28` 起，宽 6 高 8，在中线 x=32 的左侧。B 从 `54,28` 起，同样大小，在右侧。遮住颜色以后形状和灯位仍要能分开。"
    },
    {
      "id": "badge.body",
      "owner": "ue",
      "status": "spec_only",
      "text": "两名人形共用 `NR_Body_Humanoid`。A 的贴花插槽是 `socket.shoulder_left`，B 是 `socket.shoulder_right`。不要做第二套身体。"
    },
    {
      "id": "badge.noface",
      "owner": "both",
      "status": "spec_only",
      "text": "不按脸认敌我。肩章里不出现 face。不要交肖像贴图。"
    },
    {
      "id": "naming.decal",
      "owner": "both",
      "status": "spec_only",
      "text": "A 的贴花：Blender `NR_Decal_BadgeA_OpenChevron`，UE `D_NR_BadgeA_OpenChevron`。B：`NR_Decal_BadgeB_ClosedRing` / `D_NR_BadgeB_ClosedRing`。名字里不写青、琥珀或十六进制。"
    },
    {
      "id": "naming.material",
      "owner": "both",
      "status": "spec_only",
      "text": "材质按命名表。Blender 用 `NR_Mat_*`，UE 实例用 `MI_NR_*`。辅助色实例名带 Aux，角色仍是 auxiliary。母材质和实例都不要交进这个仓。"
    },
    {
      "id": "naming.notexture",
      "owner": "both",
      "status": "no_binary",
      "text": "命名表里 texture 是 `none`。不要交 png、tga、exr 或 `.uasset`。"
    },
    {
      "id": "scale.units",
      "owner": "blender",
      "status": "spec_only",
      "text": "Blender 的 1 米导出成 UE 100 单位，对齐 `ue_units_per_meter`。不要改灰盒配置来迁就模型。"
    },
    {
      "id": "engine.placeholder",
      "owner": "ue",
      "status": "repo_holds_5.4",
      "text": "`NeonRift.uproject` 的 `EngineAssociation` 保持 `5.4`。这条检查不打开编辑器。"
    },
    {
      "id": "pack.unwired",
      "owner": "both",
      "status": "unwired",
      "text": "`wired_into_m2_pack` 为 false。`m2-pack` 的步骤里没有 `m2-art`。不改 `EVENT_NAMES`，不计分。"
    }
  ]
}
